# Neon DB URL provided by the Vercel-Neon integration. Read-only role is
# preferred for the read paths; a separate KILL_SWITCH_URL with UPDATE on the
# `control` table only is used for the control-plane POST route.
DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require
CONTROL_WRITE_URL=postgresql://kill_switch_user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# Optional shared secret required by the kill-switch POST route.
KILL_SWITCH_TOKEN=

# Threshold (seconds) beyond which the engine is considered dead.
NEXT_PUBLIC_HEARTBEAT_STALE_SEC=45
