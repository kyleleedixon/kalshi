# Neon connection (Vercel-Neon integration provides these)
KBE_DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# Local write-spool
KBE_SPOOL_PATH=./spool.sqlite

# Kalshi READ-ONLY credentials (V1 paper mode — read only, no order scope).
# Trade-permission keys must NEVER be committed and must NEVER be set on Vercel.
KBE_KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KBE_KALSHI_KEY_ID=
KBE_KALSHI_PRIVATE_KEY_PEM=

# Kraken (public endpoints — no key needed for market data)
KBE_KRAKEN_REST_BASE=https://api.kraken.com
KBE_KRAKEN_WS_URL=wss://ws.kraken.com/v2

# Engine identity + loop
KBE_ENGINE_ID=kbe-local-1
KBE_LOOP_INTERVAL_SEC=5
KBE_HEARTBEAT_INTERVAL_SEC=15

# Phase gate: leave PAPER for phase 1
KBE_PHASE=PAPER
